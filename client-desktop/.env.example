# =========================
# Desktop client settings
# =========================

APP_NAME=Queue Analysis Desktop
APP_ENV=development
LOG_LEVEL=INFO

# =========================
# FastAPI connection
# =========================
# Local FastAPI server:
#   http://localhost:8000
#
# API prefix:
#   /api/v1
#
# Full API base URL:
#   http://localhost:8000/api/v1
API_BASE_URL=http://localhost:8000/api/v1
REQUEST_TIMEOUT_SECONDS=10

# =========================
# Local client history
# =========================
# The server does not store global history.
# Desktop calculation history is stored locally on the client side.
#
# Available values:
#   sqlite
#   json
HISTORY_STORAGE_TYPE=sqlite
MAX_HISTORY_ITEMS=50

# JSON history file, used only if HISTORY_STORAGE_TYPE=json.
HISTORY_JSON_PATH=./data/history.json

# =========================
# Local SQLite database
# =========================
# Used only by desktop client for local calculation history.
# This is not a global/server database.
SQLITE_DATABASE_PATH=./data/history.sqlite3
SQLITE_CONNECTION_TIMEOUT_SECONDS=5
SQLITE_ECHO_SQL=false

# =========================
# UI settings
# =========================
# Available values:
#   light
#   dark
#   system
THEME=system
