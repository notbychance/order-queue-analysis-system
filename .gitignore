# =========================================================
# Global .gitignore for Order Queue Analysis System
# =========================================================
# Project modules:
# - server/         FastAPI
# - client-web/    Vue/Vite
# - client-desktop PySide6/QML
#
# Module-level .gitignore files are not required.
# Keep .dockerignore files in modules: Docker uses them separately.
# =========================================================


# =========================================================
# OS files
# =========================================================

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/


# =========================================================
# IDE / editors
# =========================================================

.idea/
.vscode/
*.code-workspace

*.swp
*.swo
*~

*.suo
*.ntvs*
*.njsproj
*.sln


# =========================================================
# Environment files
# =========================================================
# Store only examples in Git.

.env
.env.*
**/.env
**/.env.*

!.env.example
!.env.*.example
!**/.env.example


# =========================================================
# Python
# =========================================================

__pycache__/
**/__pycache__/

*.py[cod]
*$py.class
*.pyo
*.pyd

.python-version

.venv/
venv/
env/
ENV/
**/.venv/
**/venv/
**/env/

pip-wheel-metadata/
*.egg-info/
.eggs/

.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

.coverage
.coverage.*
coverage.xml
htmlcov/
**/htmlcov/

.pyre/
.pytype/
.dmypy.json
dmypy.json

.ipynb_checkpoints/


# =========================================================
# Python build / packaging
# =========================================================

build/
dist/
**/build/
**/dist/

*.manifest
*.spec

# Keep the real PyInstaller spec for desktop build.
!client-desktop/QueueAnalysisDesktop.spec


# =========================================================
# Node / Vue / Vite
# =========================================================

node_modules/
**/node_modules/

client-web/dist/
client-web/dist-ssr/
client-web/.vite/
client-web/.cache/
client-web/.output/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

*.tsbuildinfo
.eslintcache
client-web/.eslintcache

# Vite temporary files
*.timestamp-*-*.mjs


# =========================================================
# Test artifacts
# =========================================================

coverage/
**/coverage/

test-results/
playwright-report/

# Cypress
cypress/videos/
cypress/screenshots/
client-web/cypress/videos/
client-web/cypress/screenshots/

# Vitest screenshots
__screenshots__/
client-web/__screenshots__/


# =========================================================
# Local application data
# =========================================================
# Server is stateless and should not store global history.
# Web history is in browser localStorage.
# Desktop history is local SQLite.

server/data/
client-desktop/data/

*.db
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db-shm
*.db-wal


# =========================================================
# Logs
# =========================================================

logs/
**/logs/
*.log


# =========================================================
# Temporary files and archives
# =========================================================

*.tmp
*.temp
*.bak
*.backup
*.orig

*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.gz


# =========================================================
# Docker local override files
# =========================================================

docker-compose.override.yml
compose.override.yml


# =========================================================
# Local generated reports
# =========================================================

reports/
**/reports/
