# =========================
# FastAPI server
# =========================

server/.env
server/.env.*
!server/.env.example

server/__pycache__/
server/.pytest_cache/

# SQLite / local DB files
server/*.db
server/*.sqlite
server/*.sqlite3

# Alembic local temporary files, if any
server/alembic/tmp/


# =========================
# PySide6 desktop client
# =========================

client-desktop/.env
client-desktop/.env.*
!client-desktop/.env.example

client-desktop/__pycache__/
