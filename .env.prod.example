# Production Docker Compose settings for docker-compose.prod.yml

# Replace with your real repository path.
# Example:
# GHCR_IMAGE_PREFIX=ghcr.io/notbychance/order-queue-analysis-system
GHCR_IMAGE_PREFIX=ghcr.io/<owner>/<repository>

# Use v1.0.0, v1.0.1, latest, sha-...
APP_VERSION=latest

SERVER_PORT=8000
WEB_PORT=8080

SERVER_APP_NAME=Queue Analysis API
SERVER_APP_ENV=publish
SERVER_DEBUG=false
SERVER_API_PREFIX=/api/v1
SERVER_LOG_LEVEL=INFO

# For local Docker launch:
SERVER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SERVER_CORS_ALLOW_CREDENTIALS=false
