APP_NAME=Queue Analysis API
APP_ENV=development
DEBUG=true

API_PREFIX=/api/v1

# development/develop/dev/local:
#   CORS allows every origin automatically; CORS_ORIGINS is ignored.
# publish/production/prod/release:
#   CORS allows only origins from CORS_ORIGINS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=false

LOG_LEVEL=INFO
