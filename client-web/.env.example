# Web client settings for Vite.
# Copy this file to .env for local development if you want to override defaults.

# Local FastAPI server. In development the Vue app usually runs at http://localhost:5173.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout for API calls.
VITE_REQUEST_TIMEOUT_MS=10000

# Application name displayed in UI.
VITE_APP_NAME=Queue Analysis Web
